{
  "name": "catechism-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:sitemap": "node scripts/generate_sitemap.cjs",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "prerender": "node scripts/prerender.mjs",
    "build": "vue-tsc -b && npm run generate:sitemap && vite build && vite build --ssr src/entry-server.ts --outDir dist/server && node scripts/prerender.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.0",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/server-renderer": "^3.5.42",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.2",
    "linkedom": "^0.18.13",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  }
}
